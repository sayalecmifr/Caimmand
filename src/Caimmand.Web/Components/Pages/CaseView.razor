@page "/cases/{Id:Guid}"
@using System.Text.Json
@using Caimmand.Application.Cases.GetDetail
@using Caimmand.Application.Cases.UpdateStatus
@using Caimmand.Application.Timeline.AddEvent
@using Caimmand.Application.Timeline.GetTimeline
@using Caimmand.Application.Participants.List
@using Caimmand.Application.Tasks.List
@using Caimmand.Domain.Enums
@using TaskStatus = Caimmand.Domain.Enums.TaskStatus
@inject GetCaseDetailHandler DetailHandler
@inject GetTimelineHandler TimelineHandler
@inject UpdateCaseStatusHandler StatusHandler
@inject AddTimelineEventHandler AddEventHandler
@inject ListParticipantsHandler ParticipantsHandler
@inject ListTasksHandler TasksHandler
@inject Caimmand.Application.Tasks.Start.StartTaskHandler TaskStartHandler
@inject Caimmand.Application.Tasks.Complete.CompleteTaskHandler TaskCompleteHandler
@inject Caimmand.Application.Tasks.Cancel.CancelTaskHandler TaskCancelHandler
@inject NavigationManager Nav

<PageTitle>Caimmand · Detalle del Caso</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="/cases" class="text-decoration-none small">&larr; Volver al listado</a>
            <h1 class="display-6 fw-semibold mb-0 mt-1">Detalle del Caso</h1>
        </div>
    </div>

    @if (Loading)
    {
        <div class="text-center py-5 text-muted">
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            Cargando...
        </div>
    }
    else if (Case is null)
    {
        <div class="alert alert-warning" role="alert">
            No se encontro el caso solicitado.
            <button class="btn btn-sm btn-outline-secondary ms-3" @onclick="GoBack">Volver al listado</button>
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div class="flex-grow-1">
                        <h2 class="h4 fw-semibold mb-1">@Case.Title</h2>
                        <div class="text-muted small">
                            <span class="fw-semibold">@Case.CaseDefinitionName</span>
                            <span class="mx-1">·</span>
                            <code>@Case.CaseDefinitionCode</code>
                        </div>
                    </div>
                    <span class="@StatusBadgeClass(Case.Status) fs-6">@StatusLabel(Case.Status)</span>
                </div>
                <hr class="my-3" />
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="text-muted small">Sistema origen</div>
                        <div class="fw-semibold">@Case.SourceSystem</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Fecha de creacion</div>
                        <div class="fw-semibold">@Case.CreatedAt.ToLocalTime().ToString("f")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Ultima actualizacion</div>
                        <div class="fw-semibold">@Case.UpdatedAt.ToLocalTime().ToString("f")</div>
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-12">
                        <div class="text-muted small">Identificador</div>
                        <code class="text-body">@Case.Id</code>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h3 class="h6 fw-semibold mb-3">Contexto</h3>
                <pre class="bg-light border p-3 rounded font-monospace small mb-0" style="white-space: pre-wrap;">@ContextPrettyJson</pre>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h3 class="h6 fw-semibold mb-3">Participantes</h3>
                @if (Participants is null || Participants.Count == 0)
                {
                    <p class="text-muted mb-0">No hay participantes registrados.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Referencia</th>
                                    <th scope="col">Tipo</th>
                                    <th scope="col">Rol</th>
                                    <th scope="col">ExternalId</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Participants)
                                {
                                    <tr>
                                        <td class="fw-semibold">@p.Reference</td>
                                        <td><span class="badge bg-secondary">@p.Type</span></td>
                                        <td>@p.Rol</td>
                                        <td class="text-muted small">@(@p.ExternalId ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h3 class="h6 fw-semibold mb-3">Tareas</h3>
                @if (Tasks is null || Tasks.Count == 0)
                {
                    <p class="text-muted mb-0">No hay tareas registradas.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-3">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Tipo</th>
                                    <th scope="col">Estado</th>
                                    <th scope="col">Vence</th>
                                    <th scope="col">Resultado</th>
                                    <th scope="col">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Tasks)
                                {
                                    <tr>
                                        <td class="fw-semibold">@t.Type</td>
                                        <td><span class="@TaskStatusBadgeClass(t.Status)">@TaskStatusLabel(t.Status)</span></td>
                                        <td class="@(IsTaskOverdue(t) ? "text-danger fw-semibold" : "text-muted")">
                                            @(t.DueAt.HasValue ? t.DueAt.Value.ToLocalTime().ToString("g") : "-")
                                        </td>
                                        <td class="text-muted small">@(@t.Result ?? "-")</td>
                                        <td>
                                            <div class="d-flex flex-wrap gap-1">
                                                @if (t.Status == nameof(TaskStatus.Pendiente))
                                                {
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => StartTask(t.Id)" disabled="@TaskActionInProgress">Iniciar</button>
                                                    <button class="btn btn-sm btn-outline-success" @onclick="() => CompleteTask(t.Id)" disabled="@TaskActionInProgress">Completar</button>
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelTask(t.Id)" disabled="@TaskActionInProgress">Cancelar</button>
                                                }
                                                else if (t.Status == nameof(TaskStatus.EnProgreso))
                                                {
                                                    <button class="btn btn-sm btn-outline-success" @onclick="() => CompleteTask(t.Id)" disabled="@TaskActionInProgress">Completar</button>
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelTask(t.Id)" disabled="@TaskActionInProgress">Cancelar</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (TaskActionError is not null)
                    {
                        <div class="text-danger small">@TaskActionError</div>
                    }
                }
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-7">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h3 class="h6 fw-semibold mb-3">Timeline</h3>
                        @if (Timeline is null || Timeline.Count == 0)
                        {
                            <p class="text-muted mb-0">No hay eventos registrados.</p>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var item in Timeline)
                                {
                                    <div class="border-start border-3 border-primary ps-3">
                                        <div class="d-flex justify-content-between align-items-baseline">
                                            <span class="fw-semibold">@item.Type</span>
                                            <small class="text-muted">@item.OccurredAt.ToLocalTime().ToString("g")</small>
                                        </div>
                                        <div class="text-muted small mb-1">
                                            @item.Origin
                                            @if (item.ParticipantId is not null && ParticipantRefs.TryGetValue(item.ParticipantId.Value, out var pref))
                                            {
                                                <span class="badge bg-light text-dark border">@pref</span>
                                            }
                                        </div>
                                        <div>@item.Content</div>
                                    </div>
                                }
                            </div>
                        }

                        @if (Case is not null && Case.Status != CaseStatus.Finalizado && Case.Status != CaseStatus.Cancelado)
                        {
                            <hr class="my-3" />
                            <h4 class="h6 fw-semibold mb-2">Agregar evento</h4>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label small text-muted mb-1">Tipo</label>
                                    <select class="form-select form-select-sm" @bind="NewEventType" @bind:event="onchange">
                                        <option value="">Seleccione...</option>
                                        <option value="Comentario">Comentario</option>
                                        <option value="Aviso">Aviso</option>
                                        <option value="Confirmacion">Confirmacion</option>
                                        <option value="Cancelacion">Cancelacion</option>
                                        <option value="Llamado">Llamado</option>
                                    </select>
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label small text-muted mb-1">Contenido</label>
                                    <input class="form-control form-control-sm" @bind="NewEventContent" placeholder="Descripcion del evento" />
                                </div>
                            </div>
                            <div class="d-flex justify-content-end mt-2">
                                <button class="btn btn-sm btn-primary" @onclick="AddEvent" disabled="@AddingEvent">
                                    @if (AddingEvent)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    }
                                    Registrar evento
                                </button>
                            </div>
                            @if (AddEventError is not null)
                            {
                                <div class="text-danger small mt-2">@AddEventError</div>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h3 class="h6 fw-semibold mb-3">Acciones</h3>
                        @{
                            var targets = CaseStatusTransitions.GetValidTargets(Case.Status);
                        }
                        @if (targets.Count == 0)
                        {
                            <p class="text-muted mb-0">El caso se encuentra en estado terminal (@StatusLabel(Case.Status)).</p>
                        }
                        else
                        {
                            <AuthorizeView Roles="Supervisor,Gerente">
                                <Authorized>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var target in targets)
                                        {
                                            <button class="btn btn-outline-primary btn-sm" @onclick="() => ChangeStatus(target)">
                                                @StatusLabel(target)
                                            </button>
                                        }
                                    </div>
                                    @if (StatusError is not null)
                                    {
                                        <div class="text-danger small mt-2">@StatusError</div>
                                    }
                                </Authorized>
                                <NotAuthorized>
                                    <p class="text-muted mb-0">El caso admite estas transiciones, pero requieren rol
                                        <strong>Supervisor</strong> o <strong>Gerente</strong>. Tu rol actual no las
                                        permite.</p>
                                </NotAuthorized>
                            </AuthorizeView>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }

    private CaseDetail? Case;
    private IReadOnlyList<TimelineEventItem>? Timeline;
    private IReadOnlyList<ParticipantItem>? Participants;
    private IReadOnlyList<TaskItem>? Tasks;
    private Dictionary<Guid, string> ParticipantRefs = new();
    private bool Loading = true;
    private string ContextPrettyJson = string.Empty;
    private string? StatusError;

    private string? NewEventType;
    private string? NewEventContent;
    private bool AddingEvent;
    private string? AddEventError;

    private bool TaskActionInProgress;
    private string? TaskActionError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Guid.TryParse(Id, out var caseId))
        {
            Case = await DetailHandler.Handle(new GetCaseDetailQuery(caseId), default);
            Timeline = await TimelineHandler.Handle(new GetTimelineQuery(caseId), default);
            Participants = await ParticipantsHandler.Handle(new ListParticipantsQuery(caseId), default);
            Tasks = await TasksHandler.Handle(new ListTasksQuery(caseId), default);
            ParticipantRefs = Participants
                .ToDictionary(p => p.ParticipantId, p => p.Reference);
            if (Case is not null)
            {
                ContextPrettyJson = JsonSerializer.Serialize(Case.Context.RootElement, new JsonSerializerOptions
                {
                    WriteIndented = true
                });
            }
        }
        Loading = false;
    }

    private async Task ChangeStatus(CaseStatus newStatus)
    {
        if (Case is null) return;
        StatusError = null;
        try
        {
            await StatusHandler.Handle(new UpdateCaseStatusCommand(Case.Id, newStatus), default);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            StatusError = ex.Message;
        }
    }

    private async Task AddEvent()
    {
        if (Case is null) return;
        AddEventError = null;

        if (string.IsNullOrWhiteSpace(NewEventType))
        {
            AddEventError = "El tipo de evento es obligatorio.";
            return;
        }

        AddingEvent = true;
        try
        {
            await AddEventHandler.Handle(
                new AddTimelineEventCommand(Case.Id, NewEventType, "Operador", NewEventContent ?? string.Empty),
                default);
            NewEventType = null;
            NewEventContent = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            AddEventError = ex.Message;
        }
        finally
        {
            AddingEvent = false;
        }
    }

    private void GoBack() => Nav.NavigateTo("/cases");

    private async Task StartTask(Guid taskId)
    {
        if (Case is null) return;
        TaskActionError = null;
        TaskActionInProgress = true;
        try
        {
            await TaskStartHandler.Handle(new Caimmand.Application.Tasks.Start.StartTaskCommand(Case.Id, taskId), default);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            TaskActionError = ex.Message;
        }
        finally
        {
            TaskActionInProgress = false;
        }
    }

    private async Task CompleteTask(Guid taskId)
    {
        if (Case is null) return;
        TaskActionError = null;
        TaskActionInProgress = true;
        try
        {
            await TaskCompleteHandler.Handle(new Caimmand.Application.Tasks.Complete.CompleteTaskCommand(Case.Id, taskId, null), default);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            TaskActionError = ex.Message;
        }
        finally
        {
            TaskActionInProgress = false;
        }
    }

    private async Task CancelTask(Guid taskId)
    {
        if (Case is null) return;
        TaskActionError = null;
        TaskActionInProgress = true;
        try
        {
            await TaskCancelHandler.Handle(new Caimmand.Application.Tasks.Cancel.CancelTaskCommand(Case.Id, taskId), default);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            TaskActionError = ex.Message;
        }
        finally
        {
            TaskActionInProgress = false;
        }
    }

    private static bool IsTaskOverdue(TaskItem t) =>
        t.DueAt.HasValue && t.DueAt.Value < DateTime.UtcNow &&
        t.Status != nameof(TaskStatus.Completada) &&
        t.Status != nameof(TaskStatus.Cancelada);

    private static string TaskStatusLabel(string s) => s switch
    {
        "Pendiente" => "Pendiente",
        "EnProgreso" => "En progreso",
        "Completada" => "Completada",
        "Cancelada" => "Cancelada",
        _ => s
    };

    private static string TaskStatusBadgeClass(string s) => s switch
    {
        "Pendiente" => "badge bg-secondary",
        "EnProgreso" => "badge bg-info text-dark",
        "Completada" => "badge bg-success",
        "Cancelada" => "badge bg-danger",
        _ => "badge bg-secondary"
    };

    private static string StatusLabel(CaseStatus s) => s switch
    {
        CaseStatus.Creado => "Creado",
        CaseStatus.EnCurso => "En curso",
        CaseStatus.Suspendido => "Suspendido",
        CaseStatus.Finalizado => "Finalizado",
        CaseStatus.Cancelado => "Cancelado",
        _ => s.ToString()
    };

    private static string StatusBadgeClass(CaseStatus s) => s switch
    {
        CaseStatus.Creado => "badge bg-primary",
        CaseStatus.EnCurso => "badge bg-info",
        CaseStatus.Suspendido => "badge bg-warning text-dark",
        CaseStatus.Finalizado => "badge bg-success",
        CaseStatus.Cancelado => "badge bg-danger",
        _ => "badge bg-secondary"
    };
}