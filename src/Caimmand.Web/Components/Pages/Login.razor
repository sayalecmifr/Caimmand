@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]

<PageTitle>Caimmand PoC · Login</PageTitle>

<div class="d-flex align-items-center justify-content-center" style="min-height: 100vh; background-color: #f5f5f7;">
    <div class="card shadow-sm" style="width: 24rem;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <h1 class="h4 fw-semibold mb-1">Caimmand</h1>
                <p class="text-muted small mb-0">Portal de operacion</p>
            </div>

            @if (LoginFailed is true)
            {
                <div class="alert alert-danger small py-2" role="alert">
                    Usuario o contrasenia incorrectos.
                </div>
            }

            <form action="/account/login" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <div class="mb-3">
                    <label class="form-label small text-muted mb-1">Usuario</label>
                    <input name="username" class="form-control" required autocomplete="username" autofocus />
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted mb-1">Contrasenia</label>
                    <input type="password" name="password" class="form-control" required autocomplete="current-password" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Ingresar</button>
            </form>

            <hr class="my-3" />
            <p class="text-muted small mb-0">
                Caimmand
                <a href="" class="text-decoration-none">README</a>
            </p>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public bool? LoginFailed { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
}