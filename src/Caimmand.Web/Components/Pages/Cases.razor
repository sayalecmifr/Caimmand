@page "/cases"
@using Caimmand.Application.CaseDefinitions.List
@using Caimmand.Application.Cases.List
@using Caimmand.Domain.Enums
@inject ListCasesHandler ListHandler
@inject ListCaseDefinitionsHandler DefinitionsHandler
@inject NavigationManager Nav

<PageTitle>Caimmand · Casos</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-semibold mb-0">Casos</h1>
            <p class="text-muted mb-0">Listado de casos gobernados por Caimmand.</p>
        </div>
        <a href="/" class="btn btn-link text-decoration-none">
            &larr; Volver al Dashboard
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Estado</label>
                    <select class="form-select" @bind="SelectedStatus" @bind:event="onchange" @bind:after="OnFilterChanged">
                        <option value="">Todos</option>
                        @foreach (var status in Enum.GetValues<CaseStatus>())
                        {
                            <option value="@status">@StatusLabel(status)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Case Definition</label>
                    <select class="form-select" @bind="SelectedCode" @bind:event="onchange" @bind:after="OnFilterChanged">
                        <option value="">Todas</option>
                        @if (Definitions is not null)
                        {
                            @foreach (var def in Definitions)
                            {
                                <option value="@def.Code">@def.Name (@def.Code)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Rango (creación)</label>
                    <select class="form-select" @bind="SelectedPreset" @bind:event="onchange" @bind:after="OnPresetChanged">
                        <option value="Manual">Manual</option>
                        <option value="Hoy">Hoy</option>
                        <option value="7d">Últimos 7 días</option>
                        <option value="30d">Últimos 30 días</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Creado desde</label>
                    <input type="date" class="form-control" @bind="CreatedFrom" @bind:format="yyyy-MM-dd" @bind:event="onchange" @bind:after="OnFilterChanged" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Creado hasta</label>
                    <input type="date" class="form-control" @bind="CreatedTo" @bind:format="yyyy-MM-dd" @bind:event="onchange" @bind:after="OnFilterChanged" />
                </div>
            </div>
            <div class="row g-3 align-items-end mt-1">
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Actualizado desde</label>
                    <input type="date" class="form-control" @bind="UpdatedFrom" @bind:format="yyyy-MM-dd" @bind:event="onchange" @bind:after="OnFilterChanged" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Actualizado hasta</label>
                    <input type="date" class="form-control" @bind="UpdatedTo" @bind:format="yyyy-MM-dd" @bind:event="onchange" @bind:after="OnFilterChanged" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Por página</label>
                    <select class="form-select" @bind="pageSize" @bind:event="onchange" @bind:after="OnFilterChanged">
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">
                        Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (Result is null)
    {
        <div class="text-center py-5 text-muted">
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            Cargando...
        </div>
    }
    else if (Result.Items.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            No existen casos para mostrar.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Titulo</th>
                            <th scope="col">Case Definition</th>
                            <th scope="col">Estado</th>
                            <th scope="col">Sistema origen</th>
                            <th scope="col">Fecha creacion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Result.Items)
                        {
                            <tr role="button" tabindex="0" style="cursor: pointer;"
                               @onclick="() => Open(item.Id)"
                               @onkeypress="() => Open(item.Id)">
                                <td class="fw-semibold">@item.Title</td>
                                <td>
                                    <div>@item.CaseDefinitionName</div>
                                    <div class="text-muted small">@item.CaseDefinitionCode</div>
                                </td>
                                <td><span class="@StatusBadgeClass(item.Status)">@StatusLabel(item.Status)</span></td>
                                <td>@item.SourceSystem</td>
                                <td class="text-muted">@item.CreatedAt.ToLocalTime().ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted small">
                @Result.Total caso(s) en total — Página @currentPage de @Result.TotalPages
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage <= 1)" @onclick="() => GoToPage(1)">
                    « Primera
                </button>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage <= 1)" @onclick="() => GoToPage(currentPage - 1)">
                    ‹ Anterior
                </button>
                <span class="align-self-center mx-2 small text-muted">@currentPage / @Result.TotalPages</span>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage >= Result.TotalPages)" @onclick="() => GoToPage(currentPage + 1)">
                    Siguiente ›
                </button>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage >= Result.TotalPages)" @onclick="() => GoToPage(Result.TotalPages)">
                    Última »
                </button>
            </div>
        </div>
    }
</div>

@code {
    private ListCasesResult? Result;
    private IReadOnlyList<CaseDefinitionItem>? Definitions;
    private CaseStatus? SelectedStatus;
    private string? SelectedCode;
    private string? SelectedPreset = "Manual";
    private DateTime? CreatedFrom, CreatedTo;
    private DateTime? UpdatedFrom, UpdatedTo;
    private int currentPage = 1;
    private int pageSize = 50;

    protected override async Task OnInitializedAsync()
    {
        Definitions = await DefinitionsHandler.Handle(new ListCaseDefinitionsQuery(), default);
        await LoadAsync();
    }

    private async Task OnFilterChanged()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task OnPresetChanged()
    {
        var now = DateTime.UtcNow;
        CreatedFrom = SelectedPreset switch
        {
            "Hoy" => now.Date,
            "7d" => now.AddDays(-7),
            "30d" => now.AddDays(-30),
            _ => CreatedFrom
        };
        CreatedTo = SelectedPreset switch
        {
            "Hoy" => now.Date.AddDays(1),
            "7d" => now,
            "30d" => now,
            _ => CreatedTo
        };
        currentPage = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Result = await ListHandler.Handle(new ListCasesQuery(
            SelectedStatus,
            SelectedCode,
            null,
            CreatedFrom,
            CreatedTo,
            UpdatedFrom,
            UpdatedTo,
            currentPage,
            pageSize), default);
    }

    private async Task GoToPage(int target)
    {
        currentPage = target;
        await LoadAsync();
    }

    private async Task ClearFilters()
    {
        SelectedStatus = null;
        SelectedCode = null;
        SelectedPreset = "Manual";
        CreatedFrom = null;
        CreatedTo = null;
        UpdatedFrom = null;
        UpdatedTo = null;
        currentPage = 1;
        await LoadAsync();
    }

    private void Open(Guid id) => Nav.NavigateTo($"/cases/{id}");

    private static string StatusLabel(CaseStatus s) => s switch
    {
        CaseStatus.Creado => "Creado",
        CaseStatus.EnCurso => "En curso",
        CaseStatus.Suspendido => "Suspendido",
        CaseStatus.Finalizado => "Finalizado",
        CaseStatus.Cancelado => "Cancelado",
        _ => s.ToString()
    };

    private static string StatusBadgeClass(CaseStatus s) => s switch
    {
        CaseStatus.Creado => "badge bg-primary",
        CaseStatus.EnCurso => "badge bg-info",
        CaseStatus.Suspendido => "badge bg-warning text-dark",
        CaseStatus.Finalizado => "badge bg-success",
        CaseStatus.Cancelado => "badge bg-danger",
        _ => "badge bg-secondary"
    };
}
