# Copiar a .env y ajustar si hace falta.
# .env ya esta en .gitignore (no se versiona).

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=caimmand
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Host puerto expuesto para la app
WEB_PORT=8080

# Auth (ver docs/01-architecture/ADR/ADR-002-Settings-Based-Auth.md)
# Override en todo deployment que no sea local dev.
AUTH_API_KEY=caimmand-poc-key